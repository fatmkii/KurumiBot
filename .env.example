# 复制为 .env；现有 .env 已含密钥时无需覆盖。修改后重启。
QQ_APP_ID=
QQ_APP_SECRET=
CODEX_OAUTH_PROXY_API_KEY=
CODEX_OAUTH_PROXY_MODEL=gpt-6-luna-low
# Ubuntu 部署脚本会自动将默认素材路径迁移到 data/materials/library-v1。
KURUMI_LIBRARY=materials/library-v1
KURUMI_DEFAULT_IMAGE=materials/library-v1/images/v06-p088-manual-9c6ecdf5-9300-4006-8a48-c51279382a9e.png
KURUMI_HISTORY=data/history.sqlite3
KURUMI_AI_TIMEOUT=30
KURUMI_SEND_TIMEOUT=60
KURUMI_AI_CONCURRENCY=2
KURUMI_USER_INTERVAL=5
KURUMI_SEND_ATTEMPTS=2
# 管理后台：初次启动时若密码为空，会自动生成并写入 .env。
KURUMI_ADMIN_USERNAME=admin
KURUMI_ADMIN_PASSWORD=
# 默认自动选择实际的 192.168.x.x 地址；WSL 等环境需填写实际 IPv4。
# KURUMI_ADMIN_HOST=192.168.1.100
